<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>PRISM forensic report {{ case.case_id }}</title>
<style>
  :root { --ink:#1f2937; --mute:#6b7280; --line:#e5e7eb; --amber:#d97706; --blue:#2563eb; --green:#15803d; --red:#b91c1c; }
  * { box-sizing: border-box; }
  body { font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--ink); margin: 24px; font-size: 12.5px; line-height: 1.45; }
  h1 { font-size: 22px; margin: 0 0 2px; } h2 { font-size: 16px; border-bottom: 2px solid var(--ink); padding-bottom: 3px; margin-top: 26px; }
  h3 { font-size: 14px; margin: 18px 0 6px; } .mute { color: var(--mute); }
  table { border-collapse: collapse; width: 100%; margin: 6px 0 10px; } th, td { border: 1px solid var(--line); padding: 4px 6px; text-align: left; vertical-align: top; }
  th { background: #f9fafb; font-weight: 600; } td.mono, .mono { font-family: Consolas, "Courier New", monospace; }
  .hash { font-family: Consolas, monospace; font-size: 10px; word-break: break-all; }
  .plate { font-family: Consolas, monospace; font-size: 20px; letter-spacing: 3px; font-weight: 700; }
  .q { color: var(--amber); } .inv { color: var(--blue); } .conf { color: var(--red); }
  .pill { display: inline-block; min-width: 22px; text-align: center; padding: 1px 3px; margin: 1px; border-radius: 4px; font-family: Consolas, monospace; font-size: 11px; }
  .ok { background: #dcfce7; } .low { background: #fef3c7; color: #92400e; } .fmt { background: #fee2e2; color: #991b1b; }
  .banner { padding: 10px 12px; border-radius: 6px; font-weight: 700; font-size: 14px; margin: 8px 0; }
  .MATCHED { background: #dcfce7; color: var(--green); border: 1px solid #86efac; }
  .AMBIGUOUS { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
  .NCM { background: #fee2e2; color: var(--red); border: 1px solid #fca5a5; }
  .bar { display: flex; height: 12px; width: 260px; background: #f3f4f6; border-radius: 3px; overflow: hidden; }
  .bar span { display: block; height: 100%; } .bp { background: #2563eb; } .bc { background: #f59e0b; } .bb { background: #10b981; } .bm { background: #8b5cf6; }
  img.crop { max-height: 70px; image-rendering: pixelated; border: 1px solid var(--line); }
  img.veh { max-height: 70px; } img.best { max-height: 150px; border: 1px solid var(--line); }
  img.strip { max-width: 100%; border: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 170px 1fr; gap: 12px; }
  .note { background: #eff6ff; border-left: 4px solid var(--blue); padding: 8px 10px; margin: 8px 0; }
  .warn { background: #fffbeb; border-left: 4px solid var(--amber); padding: 8px 10px; margin: 8px 0; }
  .limit { border: 2px solid var(--ink); padding: 10px; font-weight: 600; margin-top: 20px; }
  .track { page-break-inside: auto; } tr { page-break-inside: avoid; }
  ul { margin: 4px 0 4px 18px; padding: 0; }
</style>
</head>
<body>
{% macro plate_html(fp) -%}
<span class="plate">{% for p in fp.positions %}{% if p.char == '?' %}<span class="{{ 'conf' if p.source == 'conflict' else 'q' }}">?</span>{% elif p.source == 'investigator-supplied' %}<span class="inv">{{ p.char }}</span>{% else %}{{ p.char }}{% endif %}{% endfor %}{% if not fp.positions %}<span class="q">(no plate read)</span>{% endif %}</span>
{%- endmacro %}
{% macro status_banner(m) -%}
<div class="banner {{ 'NCM' if m.status.value == 'NO CONFIDENT MATCH' else m.status.value }}">{{ m.status.value }} &middot; threshold {{ m.threshold_used | f2 }}</div>
<div>{{ m.explanation }}</div>
<div class="mute">{{ m.specificity_text }}.{% if m.low_light %} Low-light clip: colour weight reduced.{% endif %}</div>
{%- endmacro %}
{% macro shortlist(m) -%}
<table>
  <tr><th>#</th><th>Registry entry</th><th>Score</th><th>Breakdown</th><th>Reasons</th></tr>
  {% for c in m.top_candidates %}
  <tr>
    <td>{{ c.rank }}</td>
    <td><b>{{ c.registry_id }}</b><br><span class="mono">{{ c.plate | pretty }}</span><br>{{ c.color }} {{ c.body_type }}<br>{{ c.make }} {{ c.model }}<br><span class="mute">{{ c.owner_region }}</span></td>
    <td><b>{{ c.score | f2 }}</b>{% if c.breakdown.capped %}<br><span class="mute">capped</span>{% endif %}</td>
    <td>
      <div class="bar">
        <span class="bp" style="width: {{ 100 * c.breakdown.plate }}%"></span><span class="bc" style="width: {{ 100 * c.breakdown.color }}%"></span><span class="bb" style="width: {{ 100 * c.breakdown.body }}%"></span><span class="bm" style="width: {{ 100 * c.breakdown.make_model }}%"></span>
      </div>
      plate {{ c.breakdown.plate | f2 }} (sim {{ c.breakdown.plate_sim | f2 }} &times; coverage {{ c.breakdown.coverage | f2 }}{% if c.breakdown.shift %}, shift {{ c.breakdown.shift }}{% endif %})<br>
      colour {{ c.breakdown.color | f2 }} &middot; body {{ c.breakdown.body | f2 }} &middot; make/model {{ c.breakdown.make_model | f2 }}
    </td>
    <td><ul>{% for r in c.reasons %}<li>{{ r }}</li>{% endfor %}</ul>
      {% if c.mismatches %}<b>Mismatches:</b><ul>{% for r in c.mismatches %}<li class="conf">{{ r }}</li>{% endfor %}</ul>{% endif %}</td>
  </tr>
  {% endfor %}
</table>
{%- endmacro %}
{% macro track_section(v, label) -%}
{% set t = v.t %}
<div class="track">
<h3>{{ label }} track {{ t.track_id }}{% if case.primary_track_id == t.track_id and label == 'Clip A' %} (primary){% endif %}</h3>
<div class="grid">
  <div>{% if v.best %}<img class="best" src="{{ v.best }}" alt="best crop">{% else %}<span class="mute">no crop</span>{% endif %}</div>
  <div>
    <div>Combined plate: {{ plate_html(t.fused) }}
      {% if t.fused.hint %}<span class="mute"> (video only: <span class="mono">{{ t.fused.video_text or '(none)' }}</span>; hint <span class="mono">{{ t.fused.hint }}</span>)</span>{% endif %}</div>
    <div class="mute">Amber <span class="q">?</span> = unknown, blue = investigator-supplied, red <span class="conf">?</span> = video/hint conflict.</div>
    <table style="width:auto">
      <tr><th>Seen</th><td>{{ t.first_seen_sec | ts }} &ndash; {{ t.last_seen_sec | ts }} ({{ t.n_detections }} detections, YOLO class {{ t.yolo_class }})</td></tr>
      <tr><th>Colour</th><td>{{ t.attributes.color.value }} ({{ t.attributes.color.confidence | f2 }}){% if t.attributes.color.uncertain %} &middot; top 2: {% for l, p in t.attributes.color.top2 %}{{ l }} {{ p | f2 }} {% endfor %}{% endif %}</td></tr>
      <tr><th>Body type</th><td>{{ t.attributes.body_type.value }} ({{ t.attributes.body_type.confidence | f2 }}) <span class="mute">{{ t.attributes.body_type.source or '' }}</span></td></tr>
      {% if t.attributes.make_model %}<tr><th>Make/model</th><td>{{ t.attributes.make_model.value }} ({{ t.attributes.make_model.confidence | f2 }}){% if t.attributes.make_model.uncertain %} <span class="mute">uncertain, not used</span>{% endif %}</td></tr>{% endif %}
    </table>
  </div>
</div>
{% if t.fused.positions %}
<b>Combined plate, confidence per position</b>
<table><tr>{% for p in t.fused.positions %}<th style="text-align:center">{{ p.index + 1 }}</th>{% endfor %}</tr>
<tr>{% for p in t.fused.positions %}<td style="text-align:center" class="mono">{{ p.char }}<br><span class="mute">{{ p.confidence | f2 }}</span><br><span class="mute" style="font-size:9px">{{ p.source }}</span></td>{% endfor %}</tr></table>
{% if t.fused.hint_conflicts %}<div class="warn">{% for c in t.fused.hint_conflicts %}{{ c }}<br>{% endfor %}</div>{% endif %}
{% endif %}
{% if v.strip %}<b>Plate evidence strip</b> <span class="mute">(column = plate position, row = read; shade = vote weight; amber cells were read below the confidence threshold and carry no weight; red letters disagree with the fused result)</span><br><img class="strip" src="{{ v.strip }}" alt="evidence strip">{% endif %}
<b>Frames used</b>
{% if v.frames %}
<table>
  <tr><th>Read</th><th>Frame</th><th>Time</th><th>Sharpness</th><th>Copy</th><th>Vehicle</th><th>Plate crop</th><th>Raw OCR</th><th>Masked</th><th>Per-character confidence</th></tr>
  {% for row in v.frames %}{% set f = row.f %}
  <tr>
    <td class="mono">{{ f.read_id }}</td><td>{{ f.frame_idx }}</td><td>{{ f.timestamp_sec | ts }}</td><td>{{ '%.1f' % f.sharpness }}</td>
    <td>{{ f.source }}{% if f.two_line %} (2-line){% endif %}</td>
    <td>{% if row.veh %}<img class="veh" src="{{ row.veh }}">{% endif %}</td>
    <td>{% if row.plate %}<img class="crop" src="{{ row.plate }}">{% endif %}</td>
    <td class="mono">{{ f.raw_text or '(empty)' }}{% if f.check_backend %}<div class="mute" style="font-size:10px" title="cross-check by {{ f.check_backend }}; it can only mask characters">check: {{ f.check_text or '(empty)' }}</div>{% endif %}</td><td class="mono">{{ f.masked_text }}</td>
    <td>{% for c in f.chars %}<span class="pill {{ 'ok' if c.char != '?' else ('fmt' if c.reason == 'format' else 'low') }}" title="{{ c.reason or 'accepted' }}">{{ c.raw_char }} {{ '%.2f' % c.conf }}</span>{% endfor %}
      {% for c in f.format_conflicts %}<div class="mute" style="font-size:10px">{{ c }}</div>{% endfor %}</td>
  </tr>
  {% endfor %}
</table>
{% else %}<p class="mute">No plate crop passed the detection, width and sharpness filters for this track.</p>{% endif %}
{% if t.match %}
<b>Scoring breakdown</b>
{{ status_banner(t.match) }}
{{ shortlist(t.match) }}
{% endif %}
{% if t.advisor %}<div class="note"><b>Advisor:</b> {{ t.advisor.text }}</div>{% endif %}
</div>
{%- endmacro %}

<h1>PRISM forensic report</h1>
<div class="mute">Plate Recovery &amp; Identification from Surveillance Media &middot; Hackasol 5.0 AIML-01</div>

<h2>1. Case header</h2>
<table style="width:auto">
  <tr><th>Case ID</th><td class="mono">{{ case.case_id }}</td></tr>
  <tr><th>Created</th><td>{{ case.created_at }}</td></tr>
  <tr><th>Mode</th><td>{{ case.mode }}</td></tr>
  <tr><th>Investigator hint</th><td class="mono">{{ case.hint or '(none)' }}{% if case.hint %} <span class="mute">investigator-supplied; never treated as video evidence</span>{% endif %}</td></tr>
  <tr><th>Match threshold</th><td>{{ case.threshold | f2 }}</td></tr>
  <tr><th>PRISM version</th><td>{{ case.prism_version }}</td></tr>
  <tr><th>Device / OCR backend</th><td>{{ case.device }} / {{ case.ocr_backend }}</td></tr>
  {% if case.stage_timings %}<tr><th>Stage timings (s)</th><td>{% for k, v in case.stage_timings.items() %}{{ k }} {{ v }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</td></tr>{% endif %}
</table>
{% for w in case.warnings %}<div class="warn">{{ w }}</div>{% endfor %}

<h2>2. Chain of custody</h2>
{% set cu = case.custody %}
{% if cu %}
<table>
  <tr><th>Item</th><th>Value</th></tr>
  {% for c in cu.clips %}
  <tr><th>Clip {{ loop.index }}: {{ c.name }}</th><td>SHA-256 <span class="hash">{{ c.sha256 }}</span><br>{{ c.width }}&times;{{ c.height }}, {{ c.fps }} fps, {{ c.frame_count }} frames, {{ c.duration_sec }} s, median brightness {{ c.median_brightness }}{% if c.low_light %} (LOW LIGHT){% endif %}</td></tr>
  {% endfor %}
  <tr><th>Config hash</th><td class="hash">{{ cu.config_hash }}</td></tr>
  {% if cu.registry_sha256 %}<tr><th>Registry SHA-256</th><td class="hash">{{ cu.registry_sha256 }}</td></tr>{% endif %}
  <tr><th>PRISM commit</th><td class="hash">{{ cu.prism_commit or 'not a git checkout' }}</td></tr>
  {% for k, v in cu.models.items() %}<tr><th>Model: {{ k }}</th><td>{{ v }}</td></tr>{% endfor %}
  {% for k, v in cu.vendor_commits.items() %}<tr><th>vendor/{{ k }}</th><td class="hash">{{ v }}</td></tr>{% endfor %}
  <tr><th>Packages</th><td>{% for k, v in cu.packages.items() %}{{ k }} {{ v }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
</table>
<h3>Thresholds and weights</h3>
<table style="width:auto">{% for k, v in thresholds %}<tr><th>{{ k }}</th><td>{{ v }}</td></tr>{% endfor %}</table>
<h3>Saved artifacts ({{ cu.artifacts | length + extra_hashes | length }})</h3>
<table>
  <tr><th>Artifact</th><th>Kind</th><th>SHA-256</th></tr>
  {% for a in cu.artifacts %}<tr><td class="mono" style="font-size:10px">{{ a.path }}</td><td>{{ a.kind }}</td><td class="hash">{{ a.sha256 }}</td></tr>{% endfor %}
  {% for a in extra_hashes %}<tr><td class="mono" style="font-size:10px">{{ a.path }}</td><td>{{ a.kind }}</td><td class="hash">{{ a.sha256 }}</td></tr>{% endfor %}
</table>
<div class="mute">Super-resolution images, if listed, are visual aids for humans only. They were never read by OCR or used in scoring, and are not reproduced in this report.</div>
{% else %}<p class="mute">No custody record.</p>{% endif %}

<h2>3. Evidence-checked summary</h2>
{% if case.narrative %}
<p>{{ case.narrative.text }}</p>
<div class="mute">Generated by: {{ case.narrative.method }}. {{ case.narrative.checked }} sentence(s) checked against the result data; {{ case.narrative.removed }} removed.</div>
{% if case.narrative.removed %}<ul>{% for s in case.narrative.sentences if not s.passed %}<li class="mute">Removed: "{{ s.text }}" ({{ s.problems | join('; ') }})</li>{% endfor %}</ul>{% endif %}
{% endif %}

<h2>4&ndash;6. Vehicle tracks, scoring breakdown and advisor notes</h2>
{% if not tracks %}<p class="mute">No vehicle tracks.</p>{% endif %}
{% for v in tracks %}{{ track_section(v, 'Clip A' if case.mode == 'crosscam' else 'Vehicle') }}{% endfor %}

{% if case.crosscam %}
<h2>Cross-camera tracking (bonus)</h2>
<div class="mute">Encoder: {{ case.crosscam.encoder }}, similarity threshold {{ case.crosscam.threshold | f2 }}. Appearance alone never links tracks: plate compatibility and body type must also hold.</div>
<table>
  <tr><th>Clip A track</th><th>Clip B track</th><th>Similarity</th><th>Plate</th><th>Body</th><th>Same vehicle</th><th>Combined plate</th><th>Status</th><th>Reasons</th></tr>
  {% for p in case.crosscam.pairs %}
  <tr><td>{{ p.track_a }}</td><td>{{ p.track_b }}</td><td>{{ p.similarity | f2 }}</td><td>{{ 'compatible' if p.plate_compatible else 'conflict' }}</td>
    <td>{{ 'match' if p.body_match else 'differs' }}</td><td><b>{{ 'yes' if p.same_vehicle else 'no' }}</b>{% if p.speed_flag %} <span class="conf">speed flag</span>{% endif %}</td>
    <td>{% if p.combined %}{{ plate_html(p.combined) }}{% else %}-{% endif %}</td>
    <td>{{ p.status_before.value if p.status_before else '' }}{% if p.status_after %} &rarr; {{ p.status_after.value }}{% endif %}{% if p.upgraded %} <b class="inv">(upgraded)</b>{% endif %}</td>
    <td><ul>{% for r in p.reasons %}<li>{{ r }}</li>{% endfor %}</ul></td></tr>
  {% endfor %}
</table>
{% for p in case.crosscam.pairs if p.combined_match %}
<h3>Combined evidence: A{{ p.track_a }} + B{{ p.track_b }}</h3>
{{ status_banner(p.combined_match) }}
{{ shortlist(p.combined_match) }}
{% endfor %}
{% for v in tracks_b %}{{ track_section(v, 'Clip B') }}{% endfor %}
{% endif %}

<h2>7. Limitations</h2>
<div class="limit">{{ limitations }}</div>
<ul class="mute">
  <li>Characters shown as <span class="q">?</span> could not be read with at least {{ case.custody.config.ocr.char_conf if case.custody else 0.7 }} confidence and a clear multi-frame majority. PRISM never fills them in.</li>
  <li>Colour and body type come from a zero-shot vision-language model and can be wrong under glare, night lighting or occlusion. Uncertain attributes add nothing to the score.</li>
  <li>The registry is synthetic. Scores rank candidates for review; they are not probabilities of identity.</li>
  <li>The advisor's leads are frames to check by eye, not evidence.</li>
</ul>
</body>
</html>
